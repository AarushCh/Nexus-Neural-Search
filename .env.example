# --- Database (required) ---
# ONE Postgres holds everything: users, wishlist, history AND the catalogue
# (pgvector for the dense index, tsvector for the lexical one). Neon is free and
# serverless; Supabase or any Postgres with the `vector` and `pg_trgm`
# extensions works identically.
#
# The catalogue used to live in a separate Qdrant Cloud cluster. Free vector
# clusters are deleted after a period of inactivity, which took the site down
# twice — consolidating removed that failure mode entirely.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Auth (REQUIRED in prod — the app refuses to boot without it) ---
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Token lifetime in minutes. Default 43200 (30 days); short values log users out
# mid-session and make searches fail silently after idling.
# ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- TMDB (required to build the catalogue) ---
# The v3 API key, not the v4 read token.
TMDB_API_KEY=

# --- Grounded RAG "API" mode (optional; falls back to hybrid results if unset) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# --- Engine tuning (optional) ---
# DENSE_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# ENABLE_RERANK=true      # ONNX cross-encoder, no torch needed
# PREFETCH=60             # candidates per retrieval channel before fusion
# DISCOVER_TTL=300        # seconds to cache the anonymous landing feed
# FORCE_VECTOR_TYPE=vector  # override halfvec detection (pgvector < 0.7)

# --- Ranking tuning (optional; see backend/ranking.py) ---
# Every constant below was measured, not guessed. Re-measure before changing.
# RRF_K=20                # rank fusion damping
# W_DENSE=1.0             # channel weights
# W_SPARSE=0.9
# W_RERANK=1.2
# QUALITY_WEIGHT=0.22     # how hard the quality prior pulls on ordering
# COSINE_FLOOR=0.48       # calibration band for the %MATCH badge — model specific
# COSINE_CEIL=0.82

# Set this to your real frontend origin in production. While it is "*", the API
# disables credentialed CORS, because browsers reject "*" + credentials.
# CORS_ORIGINS=https://your-app.vercel.app
